# GitHub API Integration
# Required for fetching GitHub contribution calendar stats in /api/github-contributions
GITHUB_TOKEN=your_github_personal_access_token_here

# Spotify Integration
# Required for displaying current track / playlist in /api/spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# YouTube API Integration
# Required for YouTube search features in /api/youtube/search
YOUTUBE_API_KEY=your_youtube_api_key_here

# Email Service Integration (Optional - Resend)
# Required for sending call booking emails in /api/notify-call
RESEND_API_KEY=your_resend_api_key_here
